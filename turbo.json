{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/output/**", "dist/**", ".output/**"]
      "env": ["VITE_API_URL"]
    },
    "lint": {
      "dependsOn": []
    }
  }
}
