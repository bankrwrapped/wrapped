{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".vercel/output/**", "dist/**", ".output/**"],
      "env": ["VITE_API_URL"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    }
  }
}
